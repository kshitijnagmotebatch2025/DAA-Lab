
#include <stdio.h>
#include <stdlib.h>

#define INF 1000000000

struct Edge {
    int u, v, w;
};

int main() {
    int n, m;
    scanf("%d", &n);
    scanf("%d", &m);

    struct Edge edges[m];

    for (int i = 0; i < m; i++) {
        scanf("%d %d %d", &edges[i].u,
              &edges[i].v, &edges[i].w);
    }

    int source;
    scanf("%d", &source);

    long long dist[n + 1];
    int parent[n + 1];

    for (int i = 1; i <= n; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }

    dist[source] = 0;

    for (int i = 1; i < n; i++) {
        int updated = 0;

        for (int j = 0; j < m; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;

            if (dist[u] != INF &&
                dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
                updated = 1;
            }
        }

        if (!updated)
            break;
    }

    for (int j = 0; j < m; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        int w = edges[j].w;

        if (dist[u] != INF &&
            dist[u] + w < dist[v]) {
            printf("Negative cycle detected\n");
            return 0;
        }
    }

    for (int v = 1; v <= n; v++) {
        if (v == source)
            continue;

        if (dist[v] == INF) {
            printf("%d INF None\n", v);
        } else {
            int path[n + 1];
            int len = 0;
            int cur = v;

            while (cur != -1 && len <= n) {
                path[len++] = cur;
                if (cur == source)
                    break;
                cur = parent[cur];
            }

            printf("%d %lld ", v, dist[v]);

            if (len == 0 || path[len - 1] != source) {
                printf("None\n");
                continue;
            }

            for (int i = len - 1; i >= 0; i--) {
                printf("%d", path[i]);
                if (i > 0)
                    printf("->");
            }

            printf("\n");
        }
    }

    return 0;
}
