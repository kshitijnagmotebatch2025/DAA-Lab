#include <stdio.h>

int a[100], subset[100];
int results[1000][100];
int sizes[1000];
int n, target, count = 0;

void sumOfSubsets(int index, int sum, int size)
{
    if (sum == target)
    {
        for (int i = 0; i < size; i++)
            results[count][i] = subset[i];

        sizes[count] = size;
        count++;
        return;
    }

    if (index == n || sum > target)
        return;

    // Include the current element
    subset[size] = a[index];
    sumOfSubsets(index + 1, sum + a[index], size + 1);

    // Exclude the current element
    sumOfSubsets(index + 1, sum, size);
}

int main(void)
{
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &target);

    sumOfSubsets(0, 0, 0);

    if (count == 0)
    {
        printf("-1\n");
    }
    else
    {
        for (int i = count - 1; i >= 0; i--)
        {
            for (int j = 0; j < sizes[i]; j++)
            {
                if (j > 0)
                    printf(" ");

                printf("%d", results[i][j]);
            }
            printf(" \n");
        }
    }

    return 0;
}
