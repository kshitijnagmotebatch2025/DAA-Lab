#include <stdio.h>

#define MAX 20
#define INF 99999999

int n, cost[MAX][MAX];
int visited[MAX];
int minCost = INF;

void tsp(int city, int count, int totalCost) {
    if (count == n) {
        if (cost[city][0] != -1) {
            int finalCost = totalCost + cost[city][0];
            if (finalCost < minCost)
                minCost = finalCost;
        }
        return;
    }

    for (int i = 0; i < n; i++) {
        if (!visited[i] && cost[city][i] != -1) {
            visited[i] = 1;
            tsp(i, count + 1, totalCost + cost[city][i]);
            visited[i] = 0;
        }
    }
}

int main() {
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    visited[0] = 1;
    tsp(0, 1, 0);

    if (minCost == INF)
        printf("-1\n");
    else
        printf("%d\n", minCost);

    return 0;
}
